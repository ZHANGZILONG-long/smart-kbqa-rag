DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost
# 生产 HTTPS 反代时可开启
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# 本地无 MySQL 时可 True；Docker 生产用 False
USE_SQLITE=False
USE_LOCMEM_CACHE=False

DB_NAME=smartkbqa
DB_USER=root
DB_PASSWORD=your-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_ROOT_PASSWORD=rootpass

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CELERY_TASK_ALWAYS_EAGER=True

CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8080
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

THROTTLE_ANON=60/min
THROTTLE_USER=300/min
THROTTLE_LOGIN=20/min
THROTTLE_ASK=30/min
THROTTLE_UPLOAD=20/min

LOG_LEVEL=INFO
ALERT_WEBHOOK_URL=

CHROMA_MODE=persistent
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION=smart_kbqa

DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

EMBEDDING_PROVIDER=sentence
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIM=384
CHUNK_SIZE=800
CHUNK_OVERLAP=120
